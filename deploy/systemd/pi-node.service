[Unit]
Description=Qt MQTT Orange Pi 3B node
Wants=network-online.target
After=network-online.target mosquitto.service

[Service]
Type=simple
User=mqtt-node
Group=mqtt-node
ExecStart=/usr/local/bin/pi_node --host localhost --port 1883 --user pi_user --pass-file /etc/mqtt_qt/pi_node.pass --id pi
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
